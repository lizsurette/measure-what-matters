# Application Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Database Configuration
DATABASE_URL=postgresql://dashboard_user:dashboard_pass@localhost:5432/dashboard_dev
POSTGRES_DB=dashboard_dev
POSTGRES_USER=dashboard_user
POSTGRES_PASSWORD=dashboard_pass

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# External Integrations
# GitHub API
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_ORG=your-organization

# Jira API
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token

# OpenAI API for Recommendations
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500

# CI/CD Integration (adjust based on your CI/CD platform)
JENKINS_URL=https://your-jenkins.company.com
JENKINS_USERNAME=your_jenkins_user
JENKINS_API_TOKEN=your_jenkins_token

# Or for GitHub Actions
GITHUB_ACTIONS_TOKEN=ghp_your_github_actions_token

# Survey Tools (example: Typeform)
TYPEFORM_API_TOKEN=tfp_your_typeform_token

# Monitoring and Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Performance Settings
CACHE_TTL=3600
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000

# Health Check Settings
HEALTH_CHECK_INTERVAL=300000
DATA_FRESHNESS_WARNING_HOURS=25
DATA_FRESHNESS_ERROR_HOURS=49

# Industry Standard Thresholds (can be overridden per metric)
# Quality Metrics
DEFAULT_DEFECT_RATE_GREEN=0.02
DEFAULT_DEFECT_RATE_YELLOW=0.05
DEFAULT_DEFECT_RATE_RED=0.10

# Efficiency Metrics
DEFAULT_DEPLOYMENT_SUCCESS_GREEN=0.95
DEFAULT_DEPLOYMENT_SUCCESS_YELLOW=0.90
DEFAULT_DEPLOYMENT_SUCCESS_RED=0.85

# Engagement Metrics
DEFAULT_NPS_GREEN=50
DEFAULT_NPS_YELLOW=30
DEFAULT_NPS_RED=10

# Development Settings (remove in production)
MOCK_EXTERNAL_APIS=false
SEED_SAMPLE_DATA=true
ENABLE_DEBUG_ROUTES=true